<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="hammer">
    <static>false</static>
    <link name="link">
      <!-- Mesh long axis is +Y in asset frame; yaw only on visual (link pose ignored by renderer). -->
      <inertial>
        <mass>0.25</mass>
        <inertia>
          <ixx>2e-4</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2e-4</iyy>
          <iyz>0</iyz>
          <izz>2e-4</izz>
        </inertia>
      </inertial>
      <!-- Collision: head box + handle cylinder. Visual: hammer.dae. -->
      <collision name="head_collision">
        <pose>-0.04 0.004 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.024 0.058 0.024</size>
          </box>
        </geometry>
        <surface>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
            <threshold>0.01</threshold>
          </bounce>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name="handle_collision">
        <pose>0.04 0.0048 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.013</radius>
            <length>0.137</length>
          </cylinder>
        </geometry>
        <surface>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
            <threshold>0.01</threshold>
          </bounce>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 0 0 1.5708</pose>
        <geometry>
          <mesh>
            <scale>0.48 0.48 0.48</scale>
            <uri>model://hammer/meshes/hammer.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
