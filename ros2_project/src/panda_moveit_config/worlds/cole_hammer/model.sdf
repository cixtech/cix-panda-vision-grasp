<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="cole_hammer">
    <static>false</static>
    <link name="link">
      <!-- Side-lying roll baked in link; collision uses head box + handle cylinder. -->
      <pose>0 0 0 1.5708 0 0</pose>
      <inertial>
        <mass>0.28</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>2e-4</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2e-4</iyy>
          <iyz>0</iyz>
          <izz>2e-4</izz>
        </inertia>
      </inertial>
      <collision name="head_collision">
        <pose>0.1155 0 -0.005 1.5708 -0.125 0</pose>
        <geometry>
          <box>
            <size>0.061 0.096 0.060</size>
          </box>
        </geometry>
        <surface>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
            <threshold>0.01</threshold>
          </bounce>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name="handle_collision">
        <pose>-0.0305 0.002 -0.02 0 1.452 0</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.231</length>
          </cylinder>
        </geometry>
        <surface>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
            <threshold>0.01</threshold>
          </bounce>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0.0006 0.0088 -0.048 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://cole_hammer/meshes/model.obj</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
